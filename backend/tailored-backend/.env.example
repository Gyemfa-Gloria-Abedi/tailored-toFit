# Local PostgreSQL (Windows development)
# Create a database named tailored_tofit, then replace YOUR_PASSWORD.
DATABASE_URL="postgresql://postgres:3008@localhost:5432/tailored_tofit"

# Hosted PostgreSQL (for example Supabase)
# Replace DATABASE_URL with the connection string from your provider when deploying.
# For a persistent backend, Supabase Session Pooler (port 5432) is a practical option.
# For Prisma CLI migrations, use a direct connection if your provider requires it.

JWT_SECRET="replace-this-with-a-long-random-secret"
PORT=4000
CORS_ORIGIN="*"
